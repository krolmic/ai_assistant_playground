{
  "mcpServers": {
    "dart": {
      "type": "stdio",
      "command": "dart",
      "args": [
        "mcp-server",
        "--force-roots-fallback"
      ],
      "env": {
        "FLUTTER_SDK": ".fvm/versions/3.35.1",
        "DART_SDK": ".fvm/versions/3.35.1/bin/cache/dart-sdk"
      }
    }
  }
}